# LLM-compatible chat completion service
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/beta
MODEL_NAME=deepseek-v4-flash
LLM_REASONING_EFFORT=high

# Use "sqlite" for local/offline graph clues or "neo4j" for the full graph backend.
JRKJ_GRAPH_MODE=sqlite

# Required only when JRKJ_GRAPH_MODE=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
